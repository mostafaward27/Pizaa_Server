# Server Port Configuration
PORT=5001

# Application Environment (development | production)
NODE_ENV=development

# Database connection URL
# For SQLite local dev: "file:./dev.db"
# For PostgreSQL production: "postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"
DATABASE_URL="file:./dev.db"

# Secret key for JWT authentication (Replace with a strong random secret in production)
JWT_SECRET=your_jwt_secret_key_here

# Allowed origins for CORS (comma-separated origins or * for all origins)
CORS_ORIGIN="*"

# Supabase API Credentials
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
SUPABASE_SECRET_KEY=your_supabase_secret_key
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
